@@ -0,0 +1,131 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import "@testing-library/jest-dom";
+import dayjs from "dayjs";
+import type { ChangeEvent } from "react";
+import { GenericSingleDatePicker } from "./index";
+
+jest.mock("antd", () => {
+	const React = jest.requireActual("react");
+	const mockDayjs = jest.requireActual("dayjs").default;
+
+	return {
+		__esModule: true,
+		DatePicker: ({
+			value,
+			onChange,
+			placeholder,
+			allowClear,
+			disabled,
+			id,
+			className,
+		}: {
+			value: dayjs.Dayjs | null;
+			onChange: (date: dayjs.Dayjs | null, dateString: string) => void;
+			placeholder?: string;
+			allowClear?: boolean;
+			disabled?: boolean;
+			id?: string;
+			className?: string;
+		}) =>
+			React.createElement(
+				"div",
+				null,
+				React.createElement("input", {
+					id,
+					className,
+					"aria-label": placeholder,
+					placeholder,
+					type: "date",
+					value: value?.format("YYYY-MM-DD") || "",
+					disabled,
+					onChange: (event: ChangeEvent<HTMLInputElement>) =>
+						onChange(
+							event.target.value
+								? mockDayjs(event.target.value)
+								: null,
+							event.target.value
+						),
+				}),
+				allowClear &&
+					value &&
+					React.createElement(
+						"button",
+						{
+							type: "button",
+							onClick: () => onChange(null, ""),
+						},
+						"Clear"
+					)
+			),
+	};
+});
+
+describe("GenericSingleDatePicker", () => {
+	it("renders its placeholder and controlled date value", () => {
+		render(
+			<GenericSingleDatePicker
+				id="effective-date"
+				value="2026-10-08"
+				placeholder="Effective date"
+			/>
+		);
+
+		expect(screen.getByLabelText("Effective date")).toHaveValue(
+			"2026-10-08"
+		);
+	});
+
+	it("emits the selected date as a YYYY-MM-DD string", () => {
+		const onChange = jest.fn();
+		render(
+			<GenericSingleDatePicker
+				value=""
+				onChange={onChange}
+				placeholder="Effective date"
+			/>
+		);
+
+		fireEvent.change(screen.getByLabelText("Effective date"), {
+			target: { value: "2026-10-08" },
+		});
+
+		expect(onChange).toHaveBeenCalledWith("2026-10-08");
+	});
+
+	it("allows clearing only when allowClear is enabled", () => {
+		const onChange = jest.fn();
+		const { rerender } = render(
+			<GenericSingleDatePicker
+				value="2026-10-08"
+				onChange={onChange}
+				allowClear
+				placeholder="Expiry date"
+			/>
+		);
+
+		fireEvent.click(screen.getByRole("button", { name: "Clear" }));
+		expect(onChange).toHaveBeenCalledWith("");
+
+		rerender(
+			<GenericSingleDatePicker
+				value="2026-10-08"
+				onChange={onChange}
+				placeholder="Expiry date"
+			/>
+		);
+
+		expect(screen.queryByRole("button", { name: "Clear" })).toBeNull();
+	});
+
+	it("passes the disabled state to the date input", () => {
+		render(
+			<GenericSingleDatePicker
+				value=""
+				disabled
+				placeholder="Effective date"
+			/>
+		);
+
+		expect(screen.getByLabelText("Effective date")).toBeDisabled();
+	});
+});
