@@ -0,0 +1,77 @@
+.genericSingleDatePickerWrapper {
+	display: flex;
+	align-items: center;
+	width: 100%;
+	height: 38px;
+	box-sizing: border-box;
+	background: #ffffff;
+	border: 1px solid #dcdfe6;
+	border-radius: 4px;
+	padding: 0 12px;
+	gap: 8px;
+	transition: border-color 0.2s ease, box-shadow 0.2s ease;
+
+	&:hover:not(.disabled) {
+		border-color: #c0c4cc;
+	}
+
+	&:focus-within:not(.disabled) {
+		border-color: #eb1700;
+		box-shadow: 0 0 0 2px rgba(235, 23, 0, 0.08);
+	}
+
+	&.disabled {
+		background: #f5f7fa;
+		cursor: not-allowed;
+		opacity: 0.7;
+	}
+
+	.genericSingleDatePrefixIcon {
+		color: #909399;
+		font-size: 14px;
+		width: 14px;
+		height: 14px;
+		flex-shrink: 0;
+		display: inline-flex;
+		align-items: center;
+		justify-content: center;
+	}
+
+	.genericSingleDatePicker.ant-picker {
+		flex: 1;
+		width: 100%;
+		height: 100%;
+		border: none !important;
+		box-shadow: none !important;
+		background: transparent !important;
+		padding: 0;
+
+		.ant-picker-input {
+			flex: 1;
+
+			> input {
+				font-size: 13px;
+				color: #303133;
+				font-family: inherit;
+
+				&::placeholder {
+					color: #a8abb2;
+				}
+			}
+		}
+
+		.ant-picker-suffix {
+			display: none !important;
+		}
+
+		.ant-picker-clear {
+			background: #ffffff;
+			color: #909399;
+			right: 0;
+
+			&:hover {
+				color: #606266;
+			}
+		}
+	}
+}
