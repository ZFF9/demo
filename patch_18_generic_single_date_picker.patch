+import { DatePicker } from "antd";
+import classNames from "classnames";
+import dayjs from "dayjs";
+import { FC } from "react";
+import CoThinkerCalendarSvgIcon from "../Icons/CoThinkerCalendarSvgIcon";
+import "./index.scss";
+
+const dateFormat = "YYYY-MM-DD";
+
+export interface IGenericSingleDatePickerProps {
+	value: string;
+	onChange?: (dateString: string) => void;
+	placeholder?: string;
+	allowClear?: boolean;
+	disabled?: boolean;
+	className?: string;
+	id?: string;
+}
+
+export const GenericSingleDatePicker: FC<IGenericSingleDatePickerProps> = ({
+	value,
+	onChange,
+	placeholder,
+	allowClear = false,
+	disabled = false,
+	className,
+	id,
+}) => {
+	const parsedValue = value ? dayjs(value, dateFormat) : null;
+	const pickerValue = parsedValue?.isValid() ? parsedValue : null;
+
+	return (
+		<div
+			className={classNames(
+				"genericSingleDatePickerWrapper",
+				{ disabled },
+				className
+			)}
+		>
+			<CoThinkerCalendarSvgIcon className="genericSingleDatePrefixIcon" />
+			<DatePicker
+				id={id}
+				className="genericSingleDatePicker"
+				popupClassName="genericSingleDatePickerDropdown"
+				value={pickerValue}
+				onChange={(_date, dateString) => onChange?.(dateString)}
+				placeholder={placeholder}
+				format={dateFormat}
+				allowClear={allowClear}
+				disabled={disabled}
+				suffixIcon={null}
+			/>
+		</div>
+	);
+};
+
+export default GenericSingleDatePicker;
