+import { useEffect, useMemo, useRef } from "react";
 import type { FC } from "react";
-import { FeedbackChart } from "../FeedbackChart";
-import type { IFeedbackTrendItem } from "../FeedbackChart";
+import { init as initChart } from "echarts";
+import type { EChartsOption } from "echarts";
+
+export interface IFeedbackTrendItem {
+	date: string;
+	totalGenerations: number;
+	thumbsUpCount: number;
+	thumbsDownCount: number;
+	ratedCount: number;
+	noFeedbackCount: number;
+	positiveFeedbackRate: number | null;
+	feedbackCoverage: number | null;
+}
 
 export interface IFeedbackTrendChartProps {
 	data: IFeedbackTrendItem[];
 	className?: string;
 }
 
-export const FeedbackTrendChart: FC<IFeedbackTrendChartProps> = (props) => (
-	<FeedbackChart type="trend" {...props} />
-);
+const GRID = { left: 52, right: 24, top: 36, bottom: 40 };
+const AXIS_LABEL_COLOR = "#64748b";
+const AXIS_LINE = { lineStyle: { color: "#e2e8f0" } };
+const Y_AXIS = {
+	type: "value" as const,
+	min: 0,
+	max: 100,
+	interval: 20,
+	axisLabel: { formatter: "{value}%", color: AXIS_LABEL_COLOR, fontSize: 12 },
+	splitLine: { lineStyle: { color: "#f1f5f9" } },
+};
+
+const formatPercent = (value: number | null | undefined, fallback = "--") =>
+	value === null || value === undefined ? fallback : `${value.toFixed(1)}%`;
+
+const getDataIndex = (params: unknown): number => {
+	const target = Array.isArray(params) ? params[0] : params;
+	return typeof target === "object" &&
+		target !== null &&
+		"dataIndex" in target &&
+		typeof target.dataIndex === "number"
+		? target.dataIndex
+		: -1;
+};
+
+const formatDate = (value: string): string => {
+	const parts = value.split("-");
+	return parts.length === 3
+		? `${Number(parts[1])}/${Number(parts[2])}`
+		: value;
+};
+
+const createTooltip = (data: IFeedbackTrendItem[]) => (params: unknown) => {
+	const item = data[getDataIndex(params)];
+	if (!item) return "";
+	return [
+		`<strong>${item.date}</strong>`,
+		`Positive feedback rate: <strong>${formatPercent(
+			item.positiveFeedbackRate
+		)}</strong>`,
+		`Positive: ${item.thumbsUpCount}`,
+		`Negative: ${item.thumbsDownCount}`,
+		`No feedback: ${item.noFeedbackCount}`,
+		`Rated: ${item.ratedCount} of ${item.totalGenerations} generations`,
+		`Feedback coverage: ${formatPercent(
+			item.feedbackCoverage,
+			"No generations"
+		)}`,
+	].join("<br/>");
+};
+
+const createOption = (data: IFeedbackTrendItem[]): EChartsOption => ({
+	tooltip: {
+		trigger: "axis",
+		confine: true,
+		formatter: createTooltip(data),
+	},
+	grid: GRID,
+	xAxis: {
+		type: "category",
+		boundaryGap: false,
+		data: data.map((item) => item.date),
+		axisLabel: {
+			color: AXIS_LABEL_COLOR,
+			fontSize: 12,
+			formatter: formatDate,
+		},
+		axisLine: AXIS_LINE,
+	},
+	yAxis: Y_AXIS,
+	series: [
+		{
+			type: "line",
+			data: data.map((item) => item.positiveFeedbackRate),
+			smooth: false,
+			symbol: "circle",
+			symbolSize: 6,
+			lineStyle: { color: "#CC0000", width: 2.5 },
+			itemStyle: { color: "#CC0000" },
+			areaStyle: {
+				color: {
+					type: "linear",
+					x: 0,
+					y: 0,
+					x2: 0,
+					y2: 1,
+					colorStops: [
+						{ offset: 0, color: "rgba(204, 0, 0, 0.22)" },
+						{ offset: 1, color: "rgba(204, 0, 0, 0.01)" },
+					],
+					global: false,
+				},
+			},
+		},
+	],
+});
+
+export const FeedbackTrendChart: FC<IFeedbackTrendChartProps> = ({
+	data,
+	className,
+}) => {
+	const chartRef = useRef<HTMLDivElement>(null);
+	const option = useMemo(() => createOption(data), [data]);
+
+	useEffect(() => {
+		if (!chartRef.current) return;
+		const chart = initChart(chartRef.current, undefined, {
+			renderer: "svg",
+		});
+		chart.setOption(option);
+		const observer = new ResizeObserver(() => chart.resize());
+		observer.observe(chartRef.current);
+		return () => {
+			observer.disconnect();
+			chart.dispose();
+		};
+	}, [option]);
+
+	return (
+		<div className={`overviewChartCard ${className || ""}`}>
+			<div className="chartCardHeader">
+				<div className="chartCardTitle">
+					Positive Feedback Trend (Last 30 Days)
+				</div>
+			</div>
+			<div className="chartCardBody">
+				<div className="chartAxisLabel">Positive Feedback Rate (%)</div>
+				<div ref={chartRef} className="echartsContainer" />
+			</div>
+		</div>
+	);
+};
 
 export default FeedbackTrendChart;
