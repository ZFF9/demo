+	{ label: "Review", range: "60%-79%", color: "#D97706" },
+	{ label: "Attention", range: "<60%", color: "#DC2626" },
+];
+const GRID = { left: 52, right: 24, top: 36, bottom: 40 };
+const AXIS_LABEL_COLOR = "#64748b";
+const AXIS_LINE = { lineStyle: { color: "#e2e8f0" } };
+const Y_AXIS = {
+	type: "value" as const,
+	min: 0,
+	max: 100,
+	interval: 20,
+	axisLabel: { formatter: "{value}%", color: AXIS_LABEL_COLOR, fontSize: 12 },
+	splitLine: { lineStyle: { color: "#f1f5f9" } },
+};
+
+const formatPercent = (value: number | null | undefined, fallback = "--") =>
+	value === null || value === undefined ? fallback : `${value.toFixed(1)}%`;
+
+const getDataIndex = (params: unknown): number => {
+	const target = Array.isArray(params) ? params[0] : params;
+	return typeof target === "object" &&
+		target !== null &&
+		"dataIndex" in target &&
+		typeof target.dataIndex === "number"
+		? target.dataIndex
+		: -1;
+};
+
+const getBarColor = (rate: number | null): string => {
+	if (rate === null) return "#94A3B8";
+	if (rate >= 80) return "#059669";
+	if (rate >= 60) return "#D97706";
+	return "#DC2626";
+};
+
+const createTooltip = (data: IRoleFeedbackItem[]) => (params: unknown) => {
+	const item = data[getDataIndex(params)];
+	if (!item) return "";
+	return [
+		`<strong>${item.role}</strong>`,
+		`Positive feedback rate: <strong>${formatPercent(
+			item.positiveFeedbackRate
+		)}</strong>`,
+		`Positive: ${item.thumbsUpCount}`,
+		`Negative: ${item.thumbsDownCount}`,
+		`No feedback: ${item.noFeedbackCount}`,
+		`Rated: ${item.ratedCount} of ${item.totalGenerations} generations`,
+		`Feedback coverage: ${formatPercent(
+			item.feedbackCoverage,
+			"No generations"
+		)}`,
+	].join("<br/>");
+};
+
+const createOption = (data: IRoleFeedbackItem[]): EChartsOption => ({
+	tooltip: {
+		trigger: "axis",
+		confine: true,
+		axisPointer: { type: "shadow" },
+		formatter: createTooltip(data),
+	},
+	grid: GRID,
+	xAxis: {
+		type: "category",
+		data: data.map((item) => item.role),
+		axisLabel: { interval: 0, fontSize: 12, color: AXIS_LABEL_COLOR },
+		axisLine: AXIS_LINE,
+	},
+	yAxis: Y_AXIS,
+	series: [
+		{
+			type: "bar",
+			barWidth: "36%",
+			data: data.map((item) => ({
+				value: item.positiveFeedbackRate ?? 0,
+				itemStyle: {
+					color: getBarColor(item.positiveFeedbackRate),
+					borderRadius: [4, 4, 0, 0],
+				},
+			})),
+			label: {
+				show: true,
+				position: "top",
+				formatter: (params: unknown) =>
+					formatPercent(
+						data[getDataIndex(params)]?.positiveFeedbackRate
+					),
+				fontSize: 12,
+				fontWeight: 600,
+				color: "#334155",
+			},
+		},
+	],
+});
+
+export const RoleFeedbackChart: FC<IRoleFeedbackChartProps> = ({
+	data,
+	className,
+}) => {
+	const chartRef = useRef<HTMLDivElement>(null);
+	const option = useMemo(() => createOption(data), [data]);
+
+	useEffect(() => {
+		if (!chartRef.current) return;
+		const chart = initChart(chartRef.current, undefined, {
+			renderer: "svg",
+		});
+		chart.setOption(option);
+		const observer = new ResizeObserver(() => chart.resize());
+		observer.observe(chartRef.current);
+		return () => {
+			observer.disconnect();
+			chart.dispose();
+		};
+	}, [option]);
+
+	return (
+		<div className={`overviewChartCard ${className || ""}`}>
+			<div className="chartCardHeader">
+				<div className="chartCardTitle">
+					Positive Feedback Rate by Role (Last 30 Days)
+				</div>
+			</div>
+			<div className="chartCardBody">
+				<div className="chartAxisLabel">Positive Feedback Rate (%)</div>
+				<div ref={chartRef} className="echartsContainer" />
+				<div className="feedbackLegend">
+					{RATE_BANDS.map((band) => (
+						<span key={band.label} className="feedbackLegendItem">
+							<span
+								className="feedbackLegendSwatch"
+								style={{ backgroundColor: band.color }}
+							/>
+							{band.label} ({band.range})
+						</span>
+					))}
+				</div>
+			</div>
+		</div>
+	);
+};
 
 export default RoleFeedbackChart;
