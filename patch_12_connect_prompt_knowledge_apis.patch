+const getPromptExportFilename = (disposition: string | null): string => {
+	const match = disposition?.match(/filename=["']?([^"';]+)["']?/i);
+	if (match?.[1]) return match[1];
+	const date = new Date();
+	const pad = (value: number) => String(value).padStart(2, "0");
+	const utc = `${date.getUTCFullYear()}${pad(date.getUTCMonth() + 1)}${pad(
+		date.getUTCDate()
+	)}_${pad(date.getUTCHours())}${pad(date.getUTCMinutes())}${pad(
+		date.getUTCSeconds()
+	)}`;
+	return `cothinker_prompt_templates_${utc}.xlsx`;
+};
+
+async function portalGet<T>(path: `/${string}`): Promise<T> {
+	const { data, status } = await BackendHttpClient.get<{
+		code: number;
+		message: string;
+		data: T;
+	}>(path);
+	if (status === HttpStatus.OK && data?.code === 0 && "data" in data) {
+		return data.data;
+	}
+	if (data?.message) throw new Error(data.message);
+	throw new Error("Portal API error");
+}
+
+async function portalPost<T, P extends Record<string, unknown>>(
+	path: `/${string}`,
+	payload: P
+): Promise<T> {
+	const { data, status } = await BackendHttpClient.post<{
+		code: number;
+		message: string;
+		data: T;
+	}>(path, payload);
+	if (status === HttpStatus.OK && data?.code === 0 && "data" in data) {
+		return data.data;
+	}
+	if (data?.message) throw new Error(data.message);
+	throw new Error("Portal API error");
+}
+
+function pagePath(
+	basePath: string,
+	params: Record<string, string | number | undefined>
+): `/${string}` {
+	const query = new URLSearchParams();
+	Object.entries(params).forEach(([key, value]) => {
+		if (value !== undefined && value !== "") query.set(key, String(value));
+	});
+	const qs = query.toString();
+	return `${basePath}${qs ? `?${qs}` : ""}`;
+}
+
+async function getPromptVersion(
+	params: { status?: "draft"; versionId?: string; versionNo?: number } = {}
+): Promise<IPromptVersionDetail | null> {
+	const path = pagePath(PORTAL_PROMPTS_PATH, params);
+	const { data, status } = await BackendHttpClient.get<{
+		code: number;
+		message: string;
+		data: IPromptVersionDetail;
+	}>(path);
+	if (params.status === "draft" && status === HttpStatus.NOT_FOUND) {
+		return null;
+	}
+	if (status === HttpStatus.OK && data?.code === 0 && "data" in data) {
+		return data.data;
+	}
+	if (data?.message) throw new Error(data.message);
+	throw new Error("Get prompt version API error");
+}
