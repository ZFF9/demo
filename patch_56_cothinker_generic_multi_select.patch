+import { FC, ReactNode } from "react";
+import { Select } from "antd";
+import classNames from "classnames";
+import "./index.scss";
+
+export interface IGenericMultiSelectOption {
+	label: string;
+	value: string;
+	disabled?: boolean;
+}
+
+export interface IGenericMultiSelectProps {
+	value?: string[];
+	options: IGenericMultiSelectOption[];
+	onChange?: (values: string[]) => void;
+	placeholder?: ReactNode;
+	allowClear?: boolean;
+	disabled?: boolean;
+	maxTagCount?: number | "responsive";
+	className?: string;
+	popupClassName?: string;
+}
+
+export const GenericMultiSelect: FC<IGenericMultiSelectProps> = ({
+	value = [],
+	options = [],
+	onChange,
+	placeholder = "Select options",
+	allowClear = true,
+	disabled = false,
+	maxTagCount = "responsive",
+	className,
+	popupClassName,
+}) => {
+	return (
+		<div
+			className={classNames(
+				"genericMultiSelectWrapper",
+				{ disabled },
+				className
+			)}
+		>
+			<Select
+				mode="multiple"
+				className="genericMultiSelect"
+				popupClassName={classNames(
+					"genericMultiSelectDropdown",
+					popupClassName
+				)}
+				value={value}
+				options={options}
+				onChange={(nextValues: string[]) => onChange?.(nextValues)}
+				placeholder={placeholder}
+				allowClear={allowClear}
+				disabled={disabled}
+				maxTagCount={maxTagCount}
+				showArrow={true}
+			/>
+		</div>
+	);
+};
