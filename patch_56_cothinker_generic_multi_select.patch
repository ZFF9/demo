+import { render, screen, fireEvent } from "@testing-library/react";
+import "@testing-library/jest-dom";
+import { GenericMultiSelect } from "./index";
+
+describe("GenericMultiSelect Component", () => {
+	const mockOptions = [
+		{ label: "BU Marketing", value: "BU Marketing" },
+		{ label: "Sales Manager", value: "Sales Manager" },
+		{ label: "Sales Representative", value: "Sales Representative" },
+	];
+
+	it("renders placeholder when value is empty", () => {
+		render(
+			<GenericMultiSelect
+				value={[]}
+				options={mockOptions}
+				placeholder="Filter by Role"
+			/>
+		);
+
+		expect(screen.getByText("Filter by Role")).toBeInTheDocument();
+	});
+
+	it("renders selected option tags when values are provided", () => {
+		render(
+			<GenericMultiSelect
+				value={["BU Marketing", "Sales Manager"]}
+				options={mockOptions}
+			/>
+		);
+
+		expect(screen.getByText("BU Marketing")).toBeInTheDocument();
+		expect(screen.getByText("Sales Manager")).toBeInTheDocument();
+	});
+
+	it("opens dropdown and triggers onChange when an option is clicked", () => {
+		const handleChange = jest.fn();
+		const { container } = render(
+			<GenericMultiSelect
+				value={[]}
+				options={mockOptions}
+				onChange={handleChange}
+			/>
+		);
+
+		const selector = container.querySelector(".ant-select-selector");
+		if (selector) {
+			fireEvent.mouseDown(selector);
+		}
+
+		const option = screen.getByTitle("BU Marketing");
+		fireEvent.click(option);
+
+		expect(handleChange).toHaveBeenCalledWith(["BU Marketing"]);
+	});
+
+	it("applies disabled class when disabled is true", () => {
+		const { container } = render(
+			<GenericMultiSelect
+				value={[]}
+				options={mockOptions}
+				disabled={true}
+			/>
+		);
+
+		expect(container.firstChild).toHaveClass(
+			"genericMultiSelectWrapper",
+			"disabled"
+		);
+	});
+});
