+
+	.ant-select-item {
+		min-height: 34px;
+		padding: 7px 14px;
+		font-size: 13px;
+		color: #606266;
+		display: flex;
+		align-items: center;
+		justify-content: space-between;
+
+		&.ant-select-item-option-active:not(.ant-select-item-option-disabled) {
+			background-color: #f5f7fa;
+		}
