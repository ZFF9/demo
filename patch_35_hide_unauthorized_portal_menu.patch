@@ -0,0 +1,59 @@
+import { useCallback, useEffect, useState } from "react";
+import { InsightService } from "@angen_frontend/services";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { useUser } from "../../UserProvider";
+
+type AdminPortalAccess = "write" | "read" | "none";
+
+const resolveAdminPortalAccess = (
+	userGroups: string[],
+	permissions: IAdminPortalPermissions
+): AdminPortalAccess => {
+	const groups = new Set(
+		userGroups.map((group) => group.trim().toLowerCase()).filter(Boolean)
+	);
+	const matches = (configuredGroups: string[]) =>
+		configuredGroups.some((group) => {
+			const normalized = group.trim().toLowerCase();
+			return normalized !== "" && groups.has(normalized);
+		});
+
+	if (matches(permissions.writeGroups)) return "write";
+	if (matches(permissions.readGroups)) return "read";
+	return "none";
+};
+
+export const useAdminPortalPermissions = (enabled = true) => {
+	const { profile } = useUser();
+	const [access, setAccess] = useState<AdminPortalAccess | null>(null);
+	const [permissionError, setPermissionError] = useState("");
+	const [retryKey, setRetryKey] = useState(0);
+	const retry = useCallback(() => setRetryKey((value) => value + 1), []);
+
+	useEffect(() => {
+		let mounted = true;
+		setAccess(null);
+		setPermissionError("");
+		if (!enabled) return;
+
+		InsightService.getAdminPortalPermissions()
+			.then((permissions) => {
+				if (mounted) {
+					setAccess(
+						resolveAdminPortalAccess(
+							profile?.shortenedAdGroupsForGtm || [],
+							permissions
+						)
+					);
+				}
+			})
+			.catch((error: Error) => {
+				if (mounted) setPermissionError(error.message);
+			});
+		return () => {
+			mounted = false;
+		};
+	}, [enabled, profile, retryKey]);
+
+	return { access, permissionError, retry };
+};
