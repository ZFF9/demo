@@ -0,0 +1,120 @@
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { InsightService } from "@angen_frontend/services";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { useUser } from "../../UserProvider";
+import { useAdminPortalPermissions } from "./index";
+
+jest.mock("@angen_frontend/services", () => ({
+	InsightService: { getAdminPortalPermissions: jest.fn() },
+}));
+
+jest.mock("../../UserProvider", () => ({ useUser: jest.fn() }));
+
+describe("useAdminPortalPermissions", () => {
+	const getPermissions = jest.mocked(
+		InsightService.getAdminPortalPermissions
+	);
+	const permissions = {
+		readGroups: [" Reader-Group "],
+		writeGroups: [" Writer-Group "],
+	};
+
+	beforeEach(() => {
+		jest.resetAllMocks();
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: ["reader-group"] },
+		});
+		getPermissions.mockResolvedValue(permissions);
+	});
+
+	it.each([
+		[["reader-group"], "read"],
+		[["writer-group"], "write"],
+		[["reader-group", "writer-group"], "write"],
+		[["  ReAdEr-GrOuP  "], "read"],
+		[["unrelated-group"], "none"],
+		[[], "none"],
+	])("resolves groups %j to %s", async (groups, access) => {
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: groups },
+		});
+		const { result } = renderHook(() => useAdminPortalPermissions());
+		expect(result.current.access).toBeNull();
+		await waitFor(() => expect(result.current.access).toBe(access));
+		expect(result.current.permissionError).toBe("");
+	});
+
+	it("does not match blank group names", async () => {
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: [" "] },
+		});
+		getPermissions.mockResolvedValue({
+			readGroups: [""],
+			writeGroups: [" "],
+		});
+		const { result } = renderHook(() => useAdminPortalPermissions());
+		await waitFor(() => expect(result.current.access).toBe("none"));
+	});
+
+	it("keeps access pending until the request completes", async () => {
+		let resolve!: (value: IAdminPortalPermissions) => void;
+		getPermissions.mockReturnValue(
+			new Promise((done) => {
+				resolve = done;
+			})
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions());
+		expect(result.current.access).toBeNull();
+		await act(async () => resolve(permissions));
+		expect(result.current.access).toBe("read");
+	});
+
+	it("reports errors and reloads permissions on retry", async () => {
+		getPermissions.mockRejectedValueOnce(
+			new Error("Permission service unavailable")
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions());
+		await waitFor(() =>
+			expect(result.current.permissionError).toBe(
+				"Permission service unavailable"
+			)
+		);
+		expect(result.current.access).toBeNull();
+		act(() => result.current.retry());
+		expect(result.current.permissionError).toBe("");
+		await waitFor(() => expect(result.current.access).toBe("read"));
+		expect(getPermissions).toHaveBeenCalledTimes(2);
+	});
+
+	it("skips requests when disabled and loads when enabled", async () => {
+		const { result, rerender } = renderHook(
+			({ enabled }) => useAdminPortalPermissions(enabled),
+			{ initialProps: { enabled: false } }
+		);
+		expect(getPermissions).not.toHaveBeenCalled();
+		expect(result.current.access).toBeNull();
+		rerender({ enabled: true });
+		await waitFor(() => expect(result.current.access).toBe("read"));
+		rerender({ enabled: false });
+		expect(result.current.access).toBeNull();
+	});
+
+	it("ignores the previous user's late response", async () => {
+		let resolve!: (value: IAdminPortalPermissions) => void;
+		getPermissions.mockReturnValueOnce(
+			new Promise((done) => {
+				resolve = done;
+			})
+		);
+		const { result, rerender } = renderHook(() =>
+			useAdminPortalPermissions()
+		);
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: ["unrelated-group"] },
+		});
+		rerender();
+		await waitFor(() => expect(result.current.access).toBe("none"));
+		await act(async () => resolve(permissions));
+		expect(result.current.access).toBe("none");
+	});
+});
diff --git a/packages/components/src/Hooks/useAdminPortalPermissions/index.ts b/packages/components/src/Hooks/useAdminPortalPermissions/index.ts
new file mode 100644
index 0000000..095bde4
--- /dev/null
