+import { FC, PropsWithChildren, ReactNode } from "react";
+import { Drawer } from "antd";
+import classNames from "classnames";
+import { TranslationEntry } from "@angen_frontend/types";
+import { Text } from "../Text";
+import "./index.scss";
+
+export interface IGenericSideDrawerProps {
+	open: boolean;
+	onClose: () => void;
+	title?: TranslationEntry | ReactNode;
+	width?: number | string;
+	destroyOnClose?: boolean;
+	footer?: ReactNode;
+	className?: string;
+	rootClassName?: string;
+}
+
+const DEFAULT_DRAWER_WIDTH = 800;
+
+export const GenericSideDrawer: FC<
+	PropsWithChildren<IGenericSideDrawerProps>
+> = ({
+	open,
+	onClose,
+	title,
+	width = DEFAULT_DRAWER_WIDTH,
+	destroyOnClose = true,
+	footer,
+	className,
+	rootClassName,
+	children,
+}) => {
+	const renderedTitle =
+		title && typeof title === "object" && !(title as ReactNode) ? (
+			<Text entry={title as TranslationEntry} />
+		) : (
+			(title as ReactNode)
+		);
+
+	return (
+		<Drawer
+			open={open}
+			onClose={onClose}
+			placement="right"
+			width={width}
+			title={renderedTitle}
+			destroyOnClose={destroyOnClose}
+			footer={footer}
+			className={classNames("genericSideDrawer", className)}
+			rootClassName={classNames("genericSideDrawerRoot", rootClassName)}
+		>
+			<div className="genericSideDrawerContent">{children}</div>
+		</Drawer>
+	);
+};
