+import { FC, ReactNode } from "react";
+import { Upload } from "antd";
+import type { UploadProps } from "antd";
+import classNames from "classnames";
+import UploadSvgIcon from "../Icons/UploadSvgIcon";
+import "./index.scss";
+
+const { Dragger } = Upload;
+
+export interface IGenericUploadDraggerProps {
+	file: File | null;
+	onFileSelected: (file: File) => void;
+	onFileRemoved?: () => void;
+	accept?: string;
+	title?: ReactNode;
+	hint?: ReactNode;
+	disabled?: boolean;
+	icon?: ReactNode;
+	className?: string;
+}
+
+export const GenericUploadDragger: FC<IGenericUploadDraggerProps> = ({
+	file,
+	onFileSelected,
+	onFileRemoved,
+	accept,
+	title,
+	hint,
+	disabled = false,
+	icon = <UploadSvgIcon size={32} />,
+	className,
+}) => {
+	const uploadProps: UploadProps = {
+		name: "file",
+		multiple: false,
+		maxCount: 1,
+		accept,
+		disabled,
+		showUploadList: false,
+		beforeUpload: (selectedFile) => {
+			onFileSelected(selectedFile as unknown as File);
+			return false;
+		},
+	};
+
+	return (
+		<div className={classNames("genericUploadDraggerContainer", className)}>
+			<Dragger {...uploadProps}>
+				<div className="uploadDraggerIcon">{icon}</div>
+				{file ? (
+					<div className="uploadDraggerSelected">
+						<span className="selectedFileName">{file.name}</span>
+						{onFileRemoved && (
+							<button
+								type="button"
+								className="removeFileBtn"
+								onClick={(e) => {
+									e.stopPropagation();
+									onFileRemoved();
+								}}
+							>
+								Remove
+							</button>
+						)}
+					</div>
+				) : (
+					<div className="uploadDraggerPrompt">
+						<p className="draggerTitle">
+							{title || "Click or drag file to this area to upload"}
+						</p>
+						{hint && <p className="draggerHint">{hint}</p>}
+					</div>
+				)}
+			</Dragger>
+		</div>
+	);
+};
