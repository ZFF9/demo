+import { ReactNode } from "react";
+import { Table, TableProps } from "antd";
+import { ColumnsType } from "antd/lib/table";
+import classNames from "classnames";
+import { GenericSpin } from "../GenericSpin";
+import "./index.scss";
+
+export interface IGenericDataTablePagination {
+	current: number;
+	pageSize: number;
+	total: number;
+	onChange: (page: number, pageSize: number) => void;
+	pageSizeOptions?: string[];
+	showQuickJumper?: boolean;
+	showSizeChanger?: boolean;
+}
+
+export interface IGenericDataTableProps<T>
+	extends Omit<TableProps<T>, "columns" | "dataSource" | "pagination"> {
+	dataSource: T[];
+	columns: ColumnsType<T>;
+	rowKey: string | ((record: T) => string);
+	isLoading?: boolean;
+	pagination?: IGenericDataTablePagination | false;
+	className?: string;
+	emptyText?: ReactNode;
+}
+
+const DEFAULT_PAGE_SIZES = ["5", "10", "20"];
+
+export const GenericDataTable = <T extends object>({
+	dataSource,
+	columns,
+	rowKey,
+	isLoading = false,
+	pagination,
+	className,
+	emptyText,
+	...rest
+}: IGenericDataTableProps<T>) => {
+	const paginationConfig =
+		pagination === false
+			? false
+			: pagination
+			? {
+					current: pagination.current,
+					pageSize: pagination.pageSize,
+					total: pagination.total,
+					onChange: pagination.onChange,
+					showSizeChanger: pagination.showSizeChanger ?? true,
+					pageSizeOptions:
+						pagination.pageSizeOptions ?? DEFAULT_PAGE_SIZES,
+					showQuickJumper: pagination.showQuickJumper ?? true,
+					showTotal: (total: number) => `Total ${total}`,
+			  }
+			: false;
+
+	return (
+		<div className={classNames("genericDataTableContainer", className)}>
+			<GenericSpin spinning={isLoading}>
+				<Table<T>
+					dataSource={dataSource}
+					columns={columns}
+					rowKey={rowKey}
+					pagination={paginationConfig}
+					locale={emptyText ? { emptyText } : undefined}
+					{...rest}
+				/>
+			</GenericSpin>
+		</div>
+	);
+};
