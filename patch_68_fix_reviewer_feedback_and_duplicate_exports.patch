+import { render, screen } from "@testing-library/react";
+import "@testing-library/jest-dom";
+import { FeedbackTrendChart } from "./index";
+
+jest.mock("../FeedbackChart", () => ({
+	FeedbackChart: ({
+		type,
+		data,
+		className,
+	}: {
+		type: string;
+		data: unknown[];
+		className?: string;
+	}) => (
+		<div
+			data-testid="feedback-chart"
+			data-type={type}
+			data-count={data.length}
+			className={className}
+		/>
+	),
+}));
+
+describe("FeedbackTrendChart", () => {
+	it("renders the trend chart with its data and class name", () => {
+		render(
+			<FeedbackTrendChart
+				data={[
+					{
+						date: "2026-10-22",
+						totalGenerations: 10,
+						thumbsUpCount: 7,
+						thumbsDownCount: 3,
+						ratedCount: 10,
+						noFeedbackCount: 0,
+						positiveFeedbackRate: 70,
+						feedbackCoverage: 100,
+					},
+				]}
+				className="trend-chart"
+			/>
+		);
+
+		expect(screen.getByTestId("feedback-chart")).toHaveAttribute(
+			"data-type",
+			"trend"
+		);
+		expect(screen.getByTestId("feedback-chart")).toHaveAttribute(
+			"data-count",
+			"1"
+		);
+		expect(screen.getByTestId("feedback-chart")).toHaveClass("trend-chart");
+	});
+});
