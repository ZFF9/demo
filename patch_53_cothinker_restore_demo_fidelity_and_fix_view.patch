+import { FC, ReactNode, useMemo } from "react";
+import { DatePicker } from "antd";
+import dayjs from "dayjs";
+import classNames from "classnames";
+import CoThinkerCalendarSvgIcon from "../Icons/CoThinkerCalendarSvgIcon";
+import "./index.scss";
+
+const { RangePicker } = DatePicker;
+
+export interface IGenericDateRangePickerProps {
+	startDate?: string;
+	endDate?: string;
+	onChange?: (startDate: string, endDate: string) => void;
+	placeholder?: [string, string];
+	separator?: ReactNode;
+	format?: string;
+	allowClear?: boolean;
+	disabled?: boolean;
+	className?: string;
+}
+
+export const GenericDateRangePicker: FC<IGenericDateRangePickerProps> = ({
+	startDate = "",
+	endDate = "",
+	onChange,
+	placeholder = ["Start date", "End date"],
+	separator = "To",
+	format = "YYYY-MM-DD",
+	allowClear = true,
+	disabled = false,
+	className,
+}) => {
+	const pickerValue = useMemo<[dayjs.Dayjs | null, dayjs.Dayjs | null] | null>(
+		() => {
+			const start = startDate ? dayjs(startDate, format) : null;
+			const end = endDate ? dayjs(endDate, format) : null;
+			if (!start && !end) return null;
+			return [
+				start && start.isValid() ? start : null,
+				end && end.isValid() ? end : null,
+			];
+		},
+		[startDate, endDate, format]
+	);
+
+	const handleRangeChange = (
+		dates: [dayjs.Dayjs | null, dayjs.Dayjs | null] | null,
+		dateStrings: [string, string]
+	) => {
+		if (!onChange) return;
+		if (!dates || (!dates[0] && !dates[1])) {
+			onChange("", "");
+			return;
+		}
+		onChange(dateStrings[0] || "", dateStrings[1] || "");
+	};
+
+	return (
+		<div
+			className={classNames(
+				"genericDateRangePickerWrapper",
+				{ disabled },
+				className
+			)}
+		>
+			<CoThinkerCalendarSvgIcon className="genericDateRangePrefixIcon" />
+			<RangePicker
+				className="genericDateRangePicker"
+				popupClassName="genericDateRangePickerDropdown"
+				value={pickerValue}
+				onChange={handleRangeChange}
+				placeholder={placeholder}
+				separator={
+					<span className="genericDateRangeSeparator">
+						{separator}
+					</span>
+				}
+				format={format}
+				allowClear={allowClear}
+				disabled={disabled}
+				suffixIcon={null}
+			/>
+		</div>
+	);
+};
