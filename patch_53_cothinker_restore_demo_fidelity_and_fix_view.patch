+import { render, screen, fireEvent } from "@testing-library/react";
+import "@testing-library/jest-dom";
+import { GenericDateRangePicker } from "./index";
+
+describe("GenericDateRangePicker", () => {
+	it("renders placeholders and separator correctly", () => {
+		render(
+			<GenericDateRangePicker
+				placeholder={["Start date", "End date"]}
+				separator="To"
+			/>
+		);
+
+		expect(screen.getByPlaceholderText("Start date")).toBeInTheDocument();
+		expect(screen.getByPlaceholderText("End date")).toBeInTheDocument();
+		expect(screen.getByText("To")).toBeInTheDocument();
+	});
+
+	it("displays controlled startDate and endDate values", () => {
+		render(
+			<GenericDateRangePicker
+				startDate="2026-10-01"
+				endDate="2026-10-08"
+			/>
+		);
+
+		const startInput = screen.getByPlaceholderText(
+			"Start date"
+		) as HTMLInputElement;
+		const endInput = screen.getByPlaceholderText(
+			"End date"
+		) as HTMLInputElement;
+
+		expect(startInput.value).toBe("2026-10-01");
+		expect(endInput.value).toBe("2026-10-08");
+	});
+
+	it("triggers onChange with empty strings when cleared", () => {
+		const mockOnChange = jest.fn();
+		const { container } = render(
+			<GenericDateRangePicker
+				startDate="2026-10-01"
+				endDate="2026-10-08"
+				onChange={mockOnChange}
+			/>
+		);
+
+		const clearBtn = container.querySelector(".ant-picker-clear");
+		if (clearBtn) {
+			fireEvent.mouseDown(clearBtn);
+			fireEvent.click(clearBtn);
+			expect(mockOnChange).toHaveBeenCalledWith("", "");
+		}
+	});
+});
