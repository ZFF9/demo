+export const resolveEstimatedCost = (record: {
+	estimatedCost?: number | null;
+	inputTokens?: number | null;
+	outputTokens?: number | null;
+	totalTokens?: number | null;
+}): number | null => {
+	if (
+		record.estimatedCost !== null &&
+		record.estimatedCost !== undefined &&
+		!Number.isNaN(record.estimatedCost)
+	) {
+		return record.estimatedCost;
+	}
+	const inTok = record.inputTokens ?? 0;
+	const outTok = record.outputTokens ?? 0;
+	if (inTok > 0 || outTok > 0) {
+		return Math.max(0.01, (inTok * 0.003 + outTok * 0.006) / 1000);
+	}
+	if (record.totalTokens && record.totalTokens > 0) {
+		return Math.max(0.01, (record.totalTokens / 1000) * 0.0045);
+	}
+	return null;
+};
