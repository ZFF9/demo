@@ -0,0 +1,97 @@
+import { InsightService } from "@angen_frontend/services";
+import { ICommentaryCapabilityData } from "@angen_frontend/types";
+import {
+	FC,
+	PropsWithChildren,
+	createContext,
+	useCallback,
+	useContext,
+	useEffect,
+	useMemo,
+	useState,
+} from "react";
+
+interface ICommentaryCapabilityContext {
+	loading: boolean;
+	enabled: boolean;
+	canGeneratePage: (
+		activeTabId: string | null,
+		panelIds: string[]
+	) => boolean;
+	canGeneratePanel: (panelId: string) => boolean;
+}
+
+const CommentaryCapabilityContext = createContext<ICommentaryCapabilityContext>(
+	{
+		loading: true,
+		enabled: false,
+		canGeneratePage: () => false,
+		canGeneratePanel: () => false,
+	}
+);
+
+export const CommentaryCapabilityProvider: FC<PropsWithChildren> = ({
+	children,
+}) => {
+	const [capability, setCapability] = useState<ICommentaryCapabilityData>();
+	const [loading, setLoading] = useState(true);
+
+	useEffect(() => {
+		let active = true;
+		InsightService.getCapability()
+			.then((apiCapability) => {
+				if (!active) return;
+				setCapability(apiCapability);
+				setLoading(false);
+			})
+			.catch(() => {
+				if (!active) return;
+				setCapability(undefined);
+				setLoading(false);
+			});
+		return () => {
+			active = false;
+		};
+	}, []);
+
+	const canGeneratePage = useCallback(
+		(activeTabId: string | null, panelIds: string[]) => {
+			return Boolean(
+				!loading &&
+					capability?.enabled &&
+					activeTabId &&
+					panelIds.filter((panelId) =>
+						capability.panelIds.includes(panelId)
+					).length > 1
+			);
+		},
+		[capability, loading]
+	);
+	const canGeneratePanel = useCallback(
+		(panelId: string) => {
+			return Boolean(
+				!loading &&
+					capability?.enabled &&
+					capability.panelIds.includes(panelId)
+			);
+		},
+		[capability, loading]
+	);
+	const value = useMemo(
+		() => ({
+			loading,
+			enabled: !loading && Boolean(capability?.enabled),
+			canGeneratePage,
+			canGeneratePanel,
+		}),
+		[loading, capability, canGeneratePage, canGeneratePanel]
+	);
+	return (
+		<CommentaryCapabilityContext.Provider value={value}>
+			{children}
+		</CommentaryCapabilityContext.Provider>
+	);
+};
+
+export const useCommentaryCapability = () =>
+	useContext(CommentaryCapabilityContext);
