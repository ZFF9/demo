@@ -0,0 +1,258 @@
+import { FC, useRef, useMemo, useEffect } from "react";
+import * as echarts from "echarts";
+import type { EChartsOption } from "echarts";
+
+export interface IRoleFeedbackItem {
+	role: string;
+	totalGenerations: number;
+	thumbsUpCount: number;
+	thumbsDownCount: number;
+	ratedCount: number;
+	noFeedbackCount: number;
+	positiveFeedbackRate: number | null;
+	feedbackCoverage: number | null;
+}
+
+export interface IFeedbackTrendItem {
+	date: string;
+	totalGenerations: number;
+	thumbsUpCount: number;
+	thumbsDownCount: number;
+	ratedCount: number;
+	noFeedbackCount: number;
+	positiveFeedbackRate: number | null;
+	feedbackCoverage: number | null;
+}
+
+export type IFeedbackChartProps =
+	| {
+			type: "role";
+			data: IRoleFeedbackItem[];
+			className?: string;
+	  }
+	| {
+			type: "trend";
+			data: IFeedbackTrendItem[];
+			className?: string;
+	  };
+
+const FEEDBACK_RATE_BANDS = [
+	{ label: "Optimal", range: "80%-100%", color: "#059669" },
+	{ label: "Review", range: "60%-79%", color: "#D97706" },
+	{ label: "Attention", range: "<60%", color: "#DC2626" },
+];
+
+const getRoleBarColor = (rate: number | null | undefined): string => {
+	if (rate === null || rate === undefined) return "#94A3B8";
+	if (rate >= 80) return "#059669";
+	if (rate >= 60) return "#D97706";
+	return "#DC2626";
+};
+
+const formatPercent = (val: number | null | undefined, fallback = "--") => {
+	if (val === null || val === undefined) return fallback;
+	return `${val.toFixed(1)}%`;
+};
+
+const formatTooltipContent = (
+	title: string,
+	item: IRoleFeedbackItem | IFeedbackTrendItem
+): string => {
+	const rateStr = formatPercent(item.positiveFeedbackRate);
+	const covStr = formatPercent(item.feedbackCoverage, "No generations");
+	return [
+		`<strong>${title}</strong>`,
+		`Positive feedback rate: <strong>${rateStr}</strong>`,
+		`Positive: ${item.thumbsUpCount}`,
+		`Negative: ${item.thumbsDownCount}`,
+		`No feedback: ${item.noFeedbackCount}`,
+		`Rated: ${item.ratedCount} of ${item.totalGenerations} generations`,
+		`Feedback coverage: ${covStr}`,
+	].join("<br/>");
+};
+
+export const FeedbackChart: FC<IFeedbackChartProps> = (props) => {
+	const chartRef = useRef<HTMLDivElement>(null);
+	const isRole = props.type === "role";
+
+	const option: EChartsOption = useMemo(() => {
+		const baseAxisLine = { lineStyle: { color: "#e2e8f0" } };
+		const baseYAxis = {
+			type: "value" as const,
+			min: 0,
+			max: 100,
+			interval: 20,
+			axisLabel: {
+				formatter: "{value}%",
+				color: "#64748b",
+				fontSize: 12,
+			},
+			splitLine: { lineStyle: { color: "#f1f5f9" } },
+		};
+
+		if (isRole) {
+			const roleData = props.data as IRoleFeedbackItem[];
+			return {
+				tooltip: {
+					trigger: "axis",
+					confine: true,
+					axisPointer: { type: "shadow" },
+					formatter: (params: unknown) => {
+						const target = Array.isArray(params)
+							? params[0]
+							: params;
+						const idx = (target as { dataIndex: number })
+							?.dataIndex;
+						const item = roleData[idx];
+						if (!item) return "";
+						return formatTooltipContent(item.role, item);
+					},
+				},
+				grid: { left: 52, right: 24, top: 36, bottom: 40 },
+				xAxis: {
+					type: "category",
+					data: roleData.map((d) => d.role),
+					axisLabel: { interval: 0, fontSize: 12, color: "#64748b" },
+					axisLine: baseAxisLine,
+				},
+				yAxis: baseYAxis,
+				series: [
+					{
+						type: "bar",
+						barWidth: "36%",
+						data: roleData.map((d) => ({
+							value: d.positiveFeedbackRate ?? 0,
+							itemStyle: {
+								color: getRoleBarColor(d.positiveFeedbackRate),
+								borderRadius: [4, 4, 0, 0],
+							},
+						})),
+						label: {
+							show: true,
+							position: "top",
+							formatter: (params: unknown) => {
+								const idx = (params as { dataIndex: number })
+									.dataIndex;
+								return formatPercent(
+									roleData[idx]?.positiveFeedbackRate
+								);
+							},
+							fontSize: 12,
+							fontWeight: 600,
+							color: "#334155",
+						},
+					},
+				],
+			};
+		}
+
+		const trendData = props.data as IFeedbackTrendItem[];
+		return {
+			tooltip: {
+				trigger: "axis",
+				confine: true,
+				formatter: (params: unknown) => {
+					const target = Array.isArray(params) ? params[0] : params;
+					const idx = (target as { dataIndex: number })?.dataIndex;
+					const item = trendData[idx];
+					if (!item) return "";
+					return formatTooltipContent(item.date, item);
+				},
+			},
+			grid: { left: 52, right: 24, top: 36, bottom: 40 },
+			xAxis: {
+				type: "category",
+				boundaryGap: false,
+				data: trendData.map((d) => d.date),
+				axisLabel: {
+					color: "#64748b",
+					fontSize: 12,
+					formatter: (val: string) => {
+						const parts = val.split("-");
+						if (parts.length === 3) {
+							return `${Number(parts[1])}/${Number(parts[2])}`;
+						}
+						return val;
+					},
+				},
+				axisLine: baseAxisLine,
+			},
+			yAxis: baseYAxis,
+			series: [
+				{
+					type: "line",
+					data: trendData.map((d) => d.positiveFeedbackRate),
+					smooth: false,
+					symbol: "circle",
+					symbolSize: 6,
+					lineStyle: { color: "#CC0000", width: 2.5 },
+					itemStyle: { color: "#CC0000" },
+					areaStyle: {
+						color: {
+							type: "linear",
+							x: 0,
+							y: 0,
+							x2: 0,
+							y2: 1,
+							colorStops: [
+								{ offset: 0, color: "rgba(204, 0, 0, 0.22)" },
+								{ offset: 1, color: "rgba(204, 0, 0, 0.01)" },
+							],
+							global: false,
+						},
+					},
+				},
+			],
+		};
+	}, [isRole, props.data]);
+
+	useEffect(() => {
+		if (!chartRef.current) return;
+		const chartInstance = echarts.init(chartRef.current, undefined, {
+			renderer: "svg",
+		});
+		chartInstance.setOption(option);
+		const observer = new ResizeObserver(() => {
+			chartInstance.resize();
+		});
+		observer.observe(chartRef.current);
+		return () => {
+			observer.disconnect();
+			chartInstance.dispose();
+		};
+	}, [option]);
+
+	const title = isRole
+		? "Positive Feedback Rate by Role (Last 30 Days)"
+		: "Positive Feedback Trend (Last 30 Days)";
+
+	return (
+		<div className={`overviewChartCard ${props.className || ""}`}>
+			<div className="chartCardHeader">
+				<div className="chartCardTitle">{title}</div>
+			</div>
+			<div className="chartCardBody">
+				<div className="chartAxisLabel">Positive Feedback Rate (%)</div>
+				<div ref={chartRef} className="echartsContainer" />
+				{isRole && (
+					<div className="feedbackLegend">
+						{FEEDBACK_RATE_BANDS.map((band) => (
+							<span
+								key={band.label}
+								className="feedbackLegendItem"
+							>
+								<span
+									className="feedbackLegendSwatch"
+									style={{ backgroundColor: band.color }}
+								/>
+								{band.label} ({band.range})
+							</span>
+						))}
+					</div>
+				)}
+			</div>
+		</div>
+	);
+};
+
+export default FeedbackChart;
