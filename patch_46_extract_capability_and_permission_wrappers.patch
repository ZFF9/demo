@@ -0,0 +1,54 @@
+import {
+	AdminPortalPermissionsProvider,
+	useConfiguration,
+} from "@angen_frontend/components";
+import { InsightService } from "@angen_frontend/services";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { FC, PropsWithChildren, useCallback, useState } from "react";
+import { useSafeAsync } from "../../hook";
+
+export interface IAdminPortalPermissionsWrapperProps {
+	enabled?: boolean;
+}
+
+const getPermissionErrorMessage = (error: unknown): string => {
+	if (error instanceof Error && error.message) {
+		return error.message;
+	}
+	return "Failed to load permissions";
+};
+
+export const AdminPortalPermissionsWrapper: FC<
+	PropsWithChildren<IAdminPortalPermissionsWrapperProps>
+> = ({ children, enabled }) => {
+	const { menuRedirectUrl } = useConfiguration();
+	const isEnabled = enabled ?? Boolean(menuRedirectUrl.coThinkerAdmin);
+	const [retryKey, setRetryKey] = useState(0);
+	const {
+		error,
+		loading: requestLoading,
+		value,
+	} = useSafeAsync(async (): Promise<IAdminPortalPermissions | undefined> => {
+		if (!isEnabled) return undefined;
+		return InsightService.getAdminPortalPermissions();
+	}, [isEnabled, retryKey]);
+
+	const retry = useCallback(() => setRetryKey((count) => count + 1), []);
+	const loading = isEnabled && requestLoading;
+	const permissionError =
+		isEnabled && !requestLoading && error
+			? getPermissionErrorMessage(error)
+			: "";
+
+	return (
+		<AdminPortalPermissionsProvider
+			permissions={isEnabled && !requestLoading ? value : undefined}
+			loading={loading}
+			permissionError={permissionError}
+			retry={retry}
+			enabled={isEnabled}
+		>
+			{children}
+		</AdminPortalPermissionsProvider>
+	);
+};
