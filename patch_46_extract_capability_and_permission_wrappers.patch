+import { act, render, screen, waitFor } from "@testing-library/react";
+import { InsightService } from "@angen_frontend/services";
+import type { ICommentaryCapabilityData } from "@angen_frontend/types";
+import { PropsWithChildren } from "react";
+import { CommentaryCapabilityWrapper } from ".";
+
+jest.mock("@angen_frontend/components", () => ({
+	__esModule: true,
+	useLoading: jest.fn(),
+	CommentaryCapabilityProvider: ({
+		children,
+		capability,
+		loading,
+	}: PropsWithChildren<{
+		capability?: ICommentaryCapabilityData;
+		loading?: boolean;
+	}>) => (
+		<div
+			data-testid="mock-capability-provider"
+			data-loading={String(Boolean(loading))}
+			data-enabled={String(Boolean(capability?.enabled))}
+			data-panel-ids={(capability?.panelIds || []).join(",")}
+		>
+			{children}
+		</div>
+	),
+}));
+
+jest.mock("@angen_frontend/services", () => ({
+	__esModule: true,
+	InsightService: {
+		getCapability: jest.fn(),
+	},
+}));
+
+describe("CommentaryCapabilityWrapper", () => {
+	const originalConsoleError = global.console.error;
+
+	beforeEach(() => {
+		jest.resetAllMocks();
+		global.console.error = jest.fn();
+	});
+
+	afterEach(() => {
+		global.console.error = originalConsoleError;
+	});
+
+	it("fetches capability once and passes loading and value to provider", async () => {
+		let resolveCapability!: (value: ICommentaryCapabilityData) => void;
+		(InsightService.getCapability as jest.Mock).mockReturnValue(
+			new Promise<ICommentaryCapabilityData>((resolve) => {
+				resolveCapability = resolve;
+			})
+		);
+
+		render(
+			<CommentaryCapabilityWrapper>
+				<span data-testid="child">content</span>
+			</CommentaryCapabilityWrapper>
+		);
+
+		const provider = screen.getByTestId("mock-capability-provider");
+		expect(provider).toHaveAttribute("data-loading", "true");
+		expect(provider).toHaveAttribute("data-enabled", "false");
+		expect(screen.getByTestId("child")).toBeInTheDocument();
+
+		await act(async () => {
+			resolveCapability({
+				enabled: true,
+				panelIds: ["panel-1", "panel-2"],
+			});
+		});
+
+		expect(provider).toHaveAttribute("data-loading", "false");
+		expect(provider).toHaveAttribute("data-enabled", "true");
+		expect(provider).toHaveAttribute("data-panel-ids", "panel-1,panel-2");
+		expect(InsightService.getCapability).toHaveBeenCalledTimes(1);
+	});
+
+	it("fails closed and keeps rendering children when capability request fails", async () => {
+		(InsightService.getCapability as jest.Mock).mockRejectedValue(
+			new Error("unavailable")
+		);
+
+		render(
+			<CommentaryCapabilityWrapper>
+				<span data-testid="child">content</span>
+			</CommentaryCapabilityWrapper>
+		);
+
+		await waitFor(() =>
+			expect(
+				screen.getByTestId("mock-capability-provider")
+			).toHaveAttribute("data-loading", "false")
+		);
+
+		expect(screen.getByTestId("mock-capability-provider")).toHaveAttribute(
+			"data-enabled",
+			"false"
+		);
+		expect(screen.getByTestId("child")).toBeInTheDocument();
+		expect(global.console.error).toHaveBeenCalled();
+	});
+});
