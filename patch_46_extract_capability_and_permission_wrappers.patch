+import {
+	act,
+	fireEvent,
+	render,
+	screen,
+	waitFor,
+} from "@testing-library/react";
+import { useConfiguration } from "@angen_frontend/components";
+import { InsightService } from "@angen_frontend/services";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { PropsWithChildren } from "react";
+import { AdminPortalPermissionsWrapper } from ".";
+
+jest.mock("@angen_frontend/components", () => ({
+	__esModule: true,
+	useLoading: jest.fn(),
+	useConfiguration: jest.fn(),
+	AdminPortalPermissionsProvider: ({
+		children,
+		permissions,
+		loading,
+		permissionError,
+		retry,
+		enabled,
+	}: PropsWithChildren<{
+		permissions?: IAdminPortalPermissions;
+		loading?: boolean;
+		permissionError?: string;
+		retry?: () => void;
+		enabled?: boolean;
+	}>) => (
+		<div
+			data-testid="mock-permissions-provider"
+			data-has-permissions={String(Boolean(permissions))}
+			data-loading={String(Boolean(loading))}
+			data-error={permissionError || ""}
+			data-enabled={String(Boolean(enabled))}
+		>
+			<button type="button" onClick={retry}>
+				retry
+			</button>
+			{children}
+		</div>
+	),
+}));
+
+jest.mock("@angen_frontend/services", () => ({
+	__esModule: true,
+	InsightService: {
+		getAdminPortalPermissions: jest.fn(),
+	},
+}));
+
+describe("AdminPortalPermissionsWrapper", () => {
+	const originalConsoleError = global.console.error;
+	const getPermissions = jest.mocked(
+		InsightService.getAdminPortalPermissions
+	);
+	const permissions: IAdminPortalPermissions = {
+		readGroups: ["reader-group"],
+		writeGroups: ["writer-group"],
+	};
+
+	beforeEach(() => {
+		jest.resetAllMocks();
+		global.console.error = jest.fn();
+		getPermissions.mockResolvedValue(permissions);
+		(useConfiguration as jest.Mock).mockReturnValue({
+			menuRedirectUrl: {
+				coThinkerAdmin: "/cothinker-admin",
+			},
+		});
+	});
+
+	afterEach(() => {
+		global.console.error = originalConsoleError;
+	});
+
+	it("loads permissions and passes resolved state to provider", async () => {
+		let resolvePermissions!: (value: IAdminPortalPermissions) => void;
+		getPermissions.mockReturnValue(
+			new Promise<IAdminPortalPermissions>((resolve) => {
+				resolvePermissions = resolve;
+			})
+		);
+
+		render(
+			<AdminPortalPermissionsWrapper>
+				<span data-testid="child">admin</span>
+			</AdminPortalPermissionsWrapper>
+		);
+
+		const provider = screen.getByTestId("mock-permissions-provider");
+		expect(provider).toHaveAttribute("data-loading", "true");
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+		expect(provider).toHaveAttribute("data-error", "");
+		expect(screen.getByTestId("child")).toBeInTheDocument();
+
+		await act(async () => resolvePermissions(permissions));
+
+		expect(provider).toHaveAttribute("data-loading", "false");
+		expect(provider).toHaveAttribute("data-has-permissions", "true");
+		expect(provider).toHaveAttribute("data-error", "");
+	});
+
+	it("derives enabled state from coThinkerAdmin config unless overridden", async () => {
+		(useConfiguration as jest.Mock).mockReturnValue({
+			menuRedirectUrl: {},
+		});
+
+		const { rerender } = render(<AdminPortalPermissionsWrapper />);
+		const provider = screen.getByTestId("mock-permissions-provider");
+
+		expect(getPermissions).not.toHaveBeenCalled();
+		expect(provider).toHaveAttribute("data-enabled", "false");
+
+		rerender(<AdminPortalPermissionsWrapper enabled />);
+		await waitFor(() =>
+			expect(provider).toHaveAttribute("data-has-permissions", "true")
+		);
+		expect(provider).toHaveAttribute("data-enabled", "true");
+		expect(getPermissions).toHaveBeenCalledTimes(1);
+	});
+
+	it("reports Error message and reloads permissions on retry", async () => {
+		getPermissions.mockRejectedValueOnce(
+			new Error("Permission service unavailable")
+		);
+
+		render(<AdminPortalPermissionsWrapper />);
+
+		const provider = screen.getByTestId("mock-permissions-provider");
+		await waitFor(() =>
+			expect(provider).toHaveAttribute(
+				"data-error",
+				"Permission service unavailable"
+			)
+		);
+		expect(provider).toHaveAttribute("data-loading", "false");
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+
+		fireEvent.click(screen.getByText("retry"));
+
+		await waitFor(() =>
+			expect(provider).toHaveAttribute("data-has-permissions", "true")
+		);
+		expect(provider).toHaveAttribute("data-error", "");
+		expect(getPermissions).toHaveBeenCalledTimes(2);
+	});
+
+	it("uses fallback message for non-Error failures", async () => {
+		getPermissions.mockRejectedValueOnce("Permission service unavailable");
+
+		render(<AdminPortalPermissionsWrapper />);
+
+		const provider = screen.getByTestId("mock-permissions-provider");
+		await waitFor(() =>
+			expect(provider).toHaveAttribute(
+				"data-error",
+				"Failed to load permissions"
+			)
+		);
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+		expect(global.console.error).toHaveBeenCalled();
+	});
+
+	it("skips requests when disabled and clears stale permissions while reloading", async () => {
+		let resolveNext!: (value: IAdminPortalPermissions) => void;
+		const { rerender } = render(
+			<AdminPortalPermissionsWrapper enabled={false} />
+		);
+
+		const provider = screen.getByTestId("mock-permissions-provider");
+		expect(getPermissions).not.toHaveBeenCalled();
+		expect(provider).toHaveAttribute("data-enabled", "false");
+		expect(provider).toHaveAttribute("data-loading", "false");
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+
+		rerender(<AdminPortalPermissionsWrapper enabled={true} />);
+		await waitFor(() =>
+			expect(provider).toHaveAttribute("data-has-permissions", "true")
+		);
+
+		rerender(<AdminPortalPermissionsWrapper enabled={false} />);
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+		expect(provider).toHaveAttribute("data-loading", "false");
+
+		getPermissions.mockReturnValueOnce(
+			new Promise((resolve) => {
+				resolveNext = resolve;
+			})
+		);
+		rerender(<AdminPortalPermissionsWrapper enabled={true} />);
+		expect(provider).toHaveAttribute("data-loading", "true");
+		expect(provider).toHaveAttribute("data-has-permissions", "false");
+
+		await act(async () => resolveNext(permissions));
+		expect(provider).toHaveAttribute("data-loading", "false");
+		expect(provider).toHaveAttribute("data-has-permissions", "true");
+	});
+});
