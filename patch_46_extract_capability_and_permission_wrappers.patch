@@ -0,0 +1,117 @@
+import {
+	FC,
+	PropsWithChildren,
+	createContext,
+	useContext,
+	useMemo,
+} from "react";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { AdminPortalAccess } from "@angen_frontend/types";
+import { useUser } from "../UserProvider";
+
+interface IAdminPortalPermissionsContext {
+	access: AdminPortalAccess | null;
+	loading: boolean;
+	permissionError: string;
+	retry: () => void;
+	enabled: boolean;
+}
+
+export interface IAdminPortalPermissionsProviderProps {
+	permissions?: IAdminPortalPermissions;
+	loading?: boolean;
+	permissionError?: string;
+	retry?: () => void;
+	enabled?: boolean;
+}
+
+const noop = () => {};
+
+const AdminPortalPermissionsContext =
+	createContext<IAdminPortalPermissionsContext>({
+		access: null,
+		loading: false,
+		permissionError: "",
+		retry: noop,
+		enabled: true,
+	});
+
+const resolveAdminPortalAccess = (
+	userGroups: string[],
+	permissions: IAdminPortalPermissions
+): AdminPortalAccess | null => {
+	const groups = new Set(
+		userGroups.map((group) => group.trim().toLowerCase()).filter(Boolean)
+	);
+	const matches = (configuredGroups: string[]) =>
+		configuredGroups.some((group) => {
+			const normalized = group.trim().toLowerCase();
+			return normalized !== "" && groups.has(normalized);
+		});
+
+	if (matches(permissions.writeGroups)) return AdminPortalAccess.WRITE;
+	if (matches(permissions.readGroups)) return AdminPortalAccess.READ;
+	return null;
+};
+
+export const AdminPortalPermissionsProvider: FC<
+	PropsWithChildren<IAdminPortalPermissionsProviderProps>
+> = ({
+	children,
+	permissions,
+	loading = false,
+	permissionError = "",
+	retry = noop,
+	enabled = true,
+}) => {
+	const { profile } = useUser();
+
+	const access = useMemo(
+		() =>
+			enabled && !loading && permissions
+				? resolveAdminPortalAccess(
+						profile?.shortenedAdGroupsForGtm || [],
+						permissions
+				  )
+				: null,
+		[enabled, loading, permissions, profile]
+	);
+
+	const value = useMemo(
+		() => ({
+			access,
+			loading: enabled && loading,
+			permissionError: enabled && !loading ? permissionError : "",
+			retry,
+			enabled,
+		}),
+		[access, enabled, loading, permissionError, retry]
+	);
+
+	return (
+		<AdminPortalPermissionsContext.Provider value={value}>
+			{children}
+		</AdminPortalPermissionsContext.Provider>
+	);
+};
+
+export const useAdminPortalPermissions = (enabled = true) => {
+	const context = useContext(AdminPortalPermissionsContext);
+	return useMemo(
+		() =>
+			enabled && context.enabled
+				? {
+						access: context.access,
+						loading: context.loading,
+						permissionError: context.permissionError,
+						retry: context.retry,
+				  }
+				: {
+						access: null,
+						loading: false,
+						permissionError: "",
+						retry: context.retry,
+				  },
+		[enabled, context]
+	);
+};
