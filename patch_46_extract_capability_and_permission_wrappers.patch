@@ -0,0 +1,173 @@
+import { renderHook } from "@testing-library/react";
+import { PropsWithChildren } from "react";
+import type { IAdminPortalPermissions } from "@angen_frontend/services";
+import { AdminPortalAccess } from "@angen_frontend/types";
+import { useUser } from "../UserProvider";
+import {
+	AdminPortalPermissionsProvider,
+	useAdminPortalPermissions,
+} from "./index";
+
+jest.mock("@angen_frontend/types", () => ({
+	AdminPortalAccess: {
+		READ: "read",
+		WRITE: "write",
+	},
+}));
+
+jest.mock("../UserProvider", () => ({ useUser: jest.fn() }));
+
+describe("AdminPortalPermissionsProvider", () => {
+	const permissions: IAdminPortalPermissions = {
+		readGroups: [" Reader-Group "],
+		writeGroups: [" Writer-Group "],
+	};
+
+	beforeEach(() => {
+		jest.resetAllMocks();
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: ["reader-group"] },
+		});
+	});
+
+	it.each([
+		[["reader-group"], AdminPortalAccess.READ],
+		[["writer-group"], AdminPortalAccess.WRITE],
+		[["reader-group", "writer-group"], AdminPortalAccess.WRITE],
+		[["  ReAdEr-GrOuP  "], AdminPortalAccess.READ],
+		[["unrelated-group"], null],
+		[[], null],
+	])("resolves groups %j to %s", (groups, access) => {
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: groups },
+		});
+		const wrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider permissions={permissions}>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions(), {
+			wrapper,
+		});
+		expect(result.current.access).toBe(access);
+		expect(result.current.loading).toBe(false);
+		expect(result.current.permissionError).toBe("");
+	});
+
+	it("does not match blank group names", () => {
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: [" "] },
+		});
+		const wrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider
+				permissions={{
+					readGroups: [""],
+					writeGroups: [" "],
+				}}
+			>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions(), {
+			wrapper,
+		});
+		expect(result.current.access).toBeNull();
+	});
+
+	it("keeps access null while loading", () => {
+		const wrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider
+				permissions={permissions}
+				loading={true}
+				permissionError="ignored while loading"
+			>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions(), {
+			wrapper,
+		});
+		expect(result.current.access).toBeNull();
+		expect(result.current.loading).toBe(true);
+		expect(result.current.permissionError).toBe("");
+	});
+
+	it("exposes error and retry callback when not loading", () => {
+		const retry = jest.fn();
+		const wrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider
+				permissionError="Permission service unavailable"
+				retry={retry}
+			>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result } = renderHook(() => useAdminPortalPermissions(), {
+			wrapper,
+		});
+		expect(result.current.access).toBeNull();
+		expect(result.current.loading).toBe(false);
+		expect(result.current.permissionError).toBe(
+			"Permission service unavailable"
+		);
+		result.current.retry();
+		expect(retry).toHaveBeenCalledTimes(1);
+	});
+
+	it("returns disabled state when hook or provider enabled is false", () => {
+		const hookDisabledWrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider permissions={permissions}>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result: hookDisabledResult, rerender } = renderHook(
+			({ enabled }) => useAdminPortalPermissions(enabled),
+			{
+				initialProps: { enabled: false },
+				wrapper: hookDisabledWrapper,
+			}
+		);
+		expect(hookDisabledResult.current.access).toBeNull();
+		expect(hookDisabledResult.current.loading).toBe(false);
+
+		rerender({ enabled: true });
+		expect(hookDisabledResult.current.access).toBe(AdminPortalAccess.READ);
+
+		const providerDisabledWrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider
+				permissions={permissions}
+				loading={true}
+				permissionError="error"
+				enabled={false}
+			>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result: providerDisabledResult } = renderHook(
+			() => useAdminPortalPermissions(true),
+			{ wrapper: providerDisabledWrapper }
+		);
+		expect(providerDisabledResult.current.access).toBeNull();
+		expect(providerDisabledResult.current.loading).toBe(false);
+		expect(providerDisabledResult.current.permissionError).toBe("");
+	});
+
+	it("recalculates access when the user changes", () => {
+		const wrapper = ({ children }: PropsWithChildren) => (
+			<AdminPortalPermissionsProvider permissions={permissions}>
+				{children}
+			</AdminPortalPermissionsProvider>
+		);
+		const { result, rerender } = renderHook(
+			() => useAdminPortalPermissions(),
+			{ wrapper }
+		);
+		expect(result.current.access).toBe(AdminPortalAccess.READ);
+
+		(useUser as jest.Mock).mockReturnValue({
+			profile: { shortenedAdGroupsForGtm: ["unrelated-group"] },
+		});
+		rerender();
+		expect(result.current.access).toBeNull();
+	});
+});
diff --git a/packages/components/src/AdminPortalPermissionsProvider/index.tsx b/packages/components/src/AdminPortalPermissionsProvider/index.tsx
